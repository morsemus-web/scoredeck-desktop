# Electron build output — never commit installers to the desktop repo,
# they belong in Scoreweb/public/downloads or on a GitHub Release.
release/
release-v2/

# Scoreweb is its own separate GitHub repo (morsemus-web/hi) — never
# tracked here to avoid double-committing.
Scoreweb/

# Mobile app source IS tracked in this repo, only its build dirs excluded.
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/

# Generated PDFs — regenerated from build_*.py, no need to commit.
ScoreDeck-*.pdf

